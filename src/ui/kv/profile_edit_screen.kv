#:kivy 2.3.0
#:import dp kivy.metrics.dp

<ProfileAccentSettingRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(64)
    padding: [dp(16), dp(12)]
    spacing: dp(14)
    canvas.before:
        Color:
            rgba: app.card_bg if self.state == "normal" else app.divider_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]

    on_release: self.screen.open_color_picker() if self.screen else None

    # Icon
    MDIcon:
        icon: "palette-outline"
        theme_icon_color: "Custom"
        icon_color: root.accent_rgba
        size_hint: (None, None)
        size: (dp(26), dp(26))
        pos_hint: {"center_y": 0.5}

    # Setting Title and subtitle
    BoxLayout:
        orientation: "vertical"
        spacing: dp(2)
        pos_hint: {"center_y": 0.5}

        Label:
            text: "Цвет акцента"
            bold: True
            font_size: "15sp"
            color: app.text_color
            halign: "left"
            valign: "middle"
            text_size: (self.width, None)

        Label:
            text: "Иконки, ссылки, выделения"
            font_size: "12sp"
            color: app.secondary_text_color
            halign: "left"
            valign: "middle"
            text_size: (self.width, None)

    # Circular color preview on the right
    Widget:
        size_hint: (None, None)
        size: (dp(32), dp(32))
        pos_hint: {"center_y": 0.5}
        canvas.before:
            Color:
                rgba: root.accent_rgba
            Ellipse:
                pos: self.pos
                size: self.size
            Color:
                rgba: (1, 1, 1, 0.2) if app.theme_mode != "light" else (0, 0, 0, 0.15)
            Line:
                circle: (self.center_x, self.center_y, dp(16))
                width: dp(1.5)

    # Chevron
    MDIcon:
        icon: "chevron-right"
        theme_icon_color: "Custom"
        icon_color: app.secondary_text_color
        size_hint: (None, None)
        size: (dp(20), dp(20))
        pos_hint: {"center_y": 0.5}


<ProfileThemeSettingRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(64)
    padding: [dp(16), dp(12)]
    spacing: dp(14)
    canvas.before:
        Color:
            rgba: app.card_bg if self.state == "normal" else app.divider_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]

    on_release: self.screen.open_theme_dialog() if self.screen else None

    # Icon
    MDIcon:
        icon: "brightness-6"
        theme_icon_color: "Custom"
        icon_color: app.accent_color
        size_hint: (None, None)
        size: (dp(26), dp(26))
        pos_hint: {"center_y": 0.5}

    # Setting Title and subtitle
    BoxLayout:
        orientation: "vertical"
        spacing: dp(2)
        pos_hint: {"center_y": 0.5}

        Label:
            text: "Тема оформления"
            bold: True
            font_size: "15sp"
            color: app.text_color
            halign: "left"
            valign: "middle"
            text_size: (self.width, None)

        Label:
            text: "Светлая, Тёмная, AMOLED"
            font_size: "12sp"
            color: app.secondary_text_color
            halign: "left"
            valign: "middle"
            text_size: (self.width, None)

    # Selected theme label preview
    Label:
        text: root.theme_label
        font_size: "14sp"
        bold: True
        color: app.accent_color
        size_hint_x: None
        width: self.texture_size[0] + dp(8)
        pos_hint: {"center_y": 0.5}

    # Chevron
    MDIcon:
        icon: "chevron-right"
        theme_icon_color: "Custom"
        icon_color: app.secondary_text_color
        size_hint: (None, None)
        size: (dp(20), dp(20))
        pos_hint: {"center_y": 0.5}


