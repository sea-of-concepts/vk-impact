#:kivy 2.3.0
#:import dp kivy.metrics.dp

<ChatScreen>:
    md_bg_color: self.theme_cls.backgroundColor

    BoxLayout:
        orientation: "vertical"

        # Top App Bar with back action and chat profile
        MDTopAppBar:
            type: "small"

            MDTopAppBarLeadingButtonContainer:
                MDIconButton:
                    icon: "arrow-left"
                    on_release: root.on_back_pressed()

            MDTopAppBarTitle:
                text: root.vm.chat_title if root.vm.chat_title else "Чат"

            MDTopAppBarTrailingButtonContainer:
                MDIconButton:
                    icon: "dots-vertical"

        # Typing indicator banner
        MDLabel:
            text: "печатает..." if root.vm.is_peer_typing else ""
            font_style: "Body"
            role: "small"
            theme_text_color: "Secondary"
            padding: [dp(16), dp(2)]
            size_hint_y: None
            height: dp(18) if root.vm.is_peer_typing else 0
            opacity: 1 if root.vm.is_peer_typing else 0

        # Message Stream RecycleView with pre-calculated key_size
        RecycleView:
            id: rv_messages
            viewclass: "MessageBubble"
            data: root.vm.messages
            scroll_type: ['bars', 'content']
            bar_width: dp(4)
            scroll_y: 0

            RecycleBoxLayout:
                default_size: None, dp(64)
                default_size_hint: 1, None
                key_size: "msg_size"
                size_hint_y: None
                height: self.minimum_height
                orientation: "vertical"
                spacing: dp(6)
                padding: [dp(4), dp(8)]

        # Bottom Input Bar
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(64)
            padding: [dp(8), dp(8)]
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: (1, 1, 1, 1) if root.theme_cls.theme_style == "Light" else (0.15, 0.16, 0.18, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            MDIconButton:
                icon: "paperclip"
                pos_hint: {"center_y": 0.5}

            MDTextField:
                id: message_input
                mode: "outlined"
                size_hint_x: 1
                pos_hint: {"center_y": 0.5}
                text: root.vm.input_text
                on_text: root.vm.input_text = self.text
                multiline: False
                on_text_validate: root.on_send_pressed()
                
                MDTextFieldHintText:
                    text: "Ваше сообщение..."

            MDIconButton:
                icon: "send"
                theme_icon_color: "Custom"
                icon_color: (0.24, 0.48, 0.95, 1)
                pos_hint: {"center_y": 0.5}
                on_release: root.on_send_pressed()
