#:kivy 2.3.0
#:import dp kivy.metrics.dp

<ChatScreen>:
    md_bg_color: self.theme_cls.backgroundColor

    BoxLayout:
        orientation: "vertical"

        # Top App Bar with back action and chat profile
        MDTopAppBar:
            type: "small"

            MDTopAppBarLeadingButtonContainer:
                MDIconButton:
                    icon: "arrow-left"
                    on_release: root.on_back_pressed()

            MDTopAppBarTitle:
                text: root.vm.chat_title if root.vm.chat_title else "Чат"

            MDTopAppBarTrailingButtonContainer:
                MDIconButton:
                    icon: "dots-vertical"

        # Typing indicator banner
        MDLabel:
            text: "печатает..." if root.vm.is_peer_typing else ""
            font_style: "Body"
            role: "small"
            theme_text_color: "Secondary"
            padding: [dp(16), dp(2)]
            size_hint_y: None
            height: dp(18) if root.vm.is_peer_typing else 0
            opacity: 1 if root.vm.is_peer_typing else 0

        # Top history loading indicator
        BoxLayout:
            size_hint_y: None
            height: dp(32) if root.vm.is_loading_history else 0
            opacity: 1 if root.vm.is_loading_history else 0
            MDCircularProgressIndicator:
                size_hint: (None, None)
                size: (dp(20), dp(20))
                pos_hint: {"center_x": 0.5, "center_y": 0.5}

        # Message Stream RecycleView with pre-calculated key_size
        RecycleView:
            id: rv_messages
            viewclass: "MessageBubble"
            data: root.vm.messages
            scroll_type: ['bars', 'content']
            bar_width: dp(4)
            on_scroll_y: root.on_rv_scroll(self.scroll_y)

            RecycleBoxLayout:
                default_size: None, dp(64)
                default_size_hint: 1, None
                key_size: "msg_size"
                size_hint_y: None
                height: self.minimum_height
                orientation: "vertical"
                spacing: dp(6)
                padding: [dp(4), dp(8)]

        # Bottom Input Bar for regular chats
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: 0 if root.vm.is_channel else dp(64)
            opacity: 0 if root.vm.is_channel else 1
            disabled: root.vm.is_channel
            padding: [dp(8), dp(8)]
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: (1, 1, 1, 1) if root.theme_cls.theme_style == "Light" else (0.15, 0.16, 0.18, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            MDIconButton:
                icon: "paperclip"
                pos_hint: {"center_y": 0.5}

            MDTextField:
                id: message_input
                mode: "outlined"
                size_hint_x: 1
                pos_hint: {"center_y": 0.5}
                text: root.vm.input_text
                on_text: root.vm.input_text = self.text
                multiline: False
                on_text_validate: root.on_send_pressed()
                
                MDTextFieldHintText:
                    text: "Ваше сообщение..."

            MDIconButton:
                icon: "send"
                theme_icon_color: "Custom"
                icon_color: (0.24, 0.48, 0.95, 1)
                pos_hint: {"center_y": 0.5}
                on_release: root.on_send_pressed()

        # Bottom Notification Mode Bar for channels
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(64) if root.vm.is_channel else 0
            opacity: 1 if root.vm.is_channel else 0
            disabled: not root.vm.is_channel
            padding: [dp(16), dp(10)]
            canvas.before:
                Color:
                    rgba: (1, 1, 1, 1) if root.theme_cls.theme_style == "Light" else (0.13, 0.14, 0.16, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: root.vm.notification_button_text
                font_size: "15sp"
                bold: True
                background_normal: ""
                background_down: ""
                background_color: (0, 0, 0, 0)
                color: (0.15, 0.16, 0.18, 1) if root.theme_cls.theme_style == "Light" else (1, 1, 1, 1)
                size_hint: (1, 1)
                on_release: root.vm.toggle_channel_notifications()
                canvas.before:
                    Color:
                        rgba: (0.88, 0.9, 0.94, 1) if root.theme_cls.theme_style == "Light" else (0.22, 0.23, 0.26, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8)]

    # Floating Action Button for scrolling to bottom with unread count badge
    ScrollBottomFab:
        id: fab_scroll_bottom
        is_at_bottom: root.is_at_bottom
        unread_count: root.vm.unread_below_count
        pos_hint: {"right": 0.96}
        y: dp(76)
        on_release: root.on_scroll_to_bottom_pressed()

