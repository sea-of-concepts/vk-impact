#:kivy 2.3.0
#:import dp kivy.metrics.dp

<AccountSettingsScreen>:
    md_bg_color: app.bg_color

    BoxLayout:
        orientation: "vertical"

        # Top App Bar
        MDTopAppBar:
            type: "small"
            theme_bg_color: "Custom"
            md_bg_color: app.surface_color

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left"
                    theme_icon_color: "Custom"
                    icon_color: app.text_color
                    on_release: root.on_back_pressed()

            MDTopAppBarTitle:
                text: "Аккаунт"
                theme_text_color: "Custom"
                text_color: app.text_color

        # Content List
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(16), dp(16)]
                spacing: dp(16)

                # Карточка информации об активном аккаунте
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [dp(16), dp(16)]
                    spacing: dp(14)
                    canvas.before:
                        Color:
                            rgba: app.card_bg
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]

                    # Профиль: Аватарка + Никнейм + UID
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(64)
                        spacing: dp(14)

                        CircularAvatar:
                            source: root.avatar_url
                            impact_style: root.impact_style
                            peer_id: int(root.user_id) if root.user_id.isdigit() else 0
                            size_dp: 56
                            pos_hint: {"center_y": 0.5}

                        BoxLayout:
                            orientation: "vertical"
                            spacing: dp(3)
                            pos_hint: {"center_y": 0.5}

                            Label:
                                text: root.user_name
                                bold: True
                                font_size: "16sp"
                                color: app.text_color
                                halign: "left"
                                valign: "middle"
                                text_size: (self.width, None)
                                shorten: True
                                shorten_from: "right"

                            Label:
                                text: ("ID: " + root.user_id) if root.user_id else "Не авторизован"
                                font_size: "13sp"
                                color: app.secondary_text_color
                                halign: "left"
                                valign: "middle"
                                text_size: (self.width, None)

                            Label:
                                text: root.auth_method_label
                                font_size: "12sp"
                                color: app.accent_color
                                halign: "left"
                                valign: "middle"
                                text_size: (self.width, None)

                    # Разделитель
                    Widget:
                        size_hint_y: None
                        height: dp(1)
                        canvas:
                            Color:
                                rgba: app.divider_color
                            Rectangle:
                                pos: self.pos
                                size: self.size

                    # Кнопки действий с аккаунтом
                    BoxLayout:
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(8)

                        # 1. Добавить новый аккаунт
                        MDButton:
                            style: "tonal"
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(42)
                            on_release: root.on_add_account_pressed()
                            MDButtonIcon:
                                icon: "account-plus-outline"
                            MDButtonText:
                                text: "Добавить новый аккаунт"
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}

                        # 2. Перейти на другой аккаунт (недоступна, если аккаунт всего 1)
                        MDButton:
                            style: "tonal"
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(42)
                            disabled: not root.can_switch_account
                            opacity: 1 if root.can_switch_account else 0.45
                            on_release: root.on_switch_account_pressed() if root.can_switch_account else None
                            MDButtonIcon:
                                icon: "account-switch-outline"
                            MDButtonText:
                                text: "Перейти на другой аккаунт (" + str(root.accounts_count) + ")" if root.can_switch_account else "Перейти на другой аккаунт"
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}

                        # 3. Выйти из этого аккаунта
                        MDButton:
                            style: "text"
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(40)
                            on_release: root.on_logout_pressed()
                            MDButtonIcon:
                                icon: "logout"
                                theme_icon_color: "Custom"
                                icon_color: (0.85, 0.25, 0.25, 1)
                            MDButtonText:
                                text: "Выйти из этого аккаунта"
                                theme_text_color: "Custom"
                                text_color: (0.85, 0.25, 0.25, 1)
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}
