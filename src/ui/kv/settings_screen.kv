#:kivy 2.3.0
#:import dp kivy.metrics.dp

<SettingsScreen>:
    md_bg_color: self.theme_cls.backgroundColor

    BoxLayout:
        orientation: "vertical"

        # Top App Bar
        MDTopAppBar:
            type: "small"

            MDTopAppBarTitle:
                text: "Настройки"

        # Content List
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(16), dp(20)]
                spacing: dp(16)

                # Section 1: Application Information Card
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(84)
                    padding: [dp(16), dp(12)]
                    spacing: dp(4)
                    canvas.before:
                        Color:
                            rgba: (0.96, 0.97, 0.98, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: dp(12)

                        MDIcon:
                            icon: "information-outline"
                            theme_icon_color: "Custom"
                            icon_color: (0.24, 0.48, 0.95, 1)
                            size_hint: (None, None)
                            size: (dp(24), dp(24))
                            pos_hint: {"center_y": 0.5}

                        BoxLayout:
                            orientation: "vertical"
                            spacing: dp(2)
                            pos_hint: {"center_y": 0.5}

                            Label:
                                text: "Версия приложения"
                                bold: True
                                font_size: "15sp"
                                color: (0.1, 0.12, 0.16, 1)
                                halign: "left"
                                valign: "middle"
                                text_size: (self.width, None)

                            Label:
                                text: root.app_name + " v" + root.app_version
                                font_size: "13sp"
                                color: (0.45, 0.48, 0.54, 1)
                                halign: "left"
                                valign: "middle"
                                text_size: (self.width, None)

                # Section 2: Account info (if logged in)
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(84) if root.user_id else 0
                    opacity: 1 if root.user_id else 0
                    padding: [dp(16), dp(12)]
                    spacing: dp(4)
                    canvas.before:
                        Color:
                            rgba: (0.96, 0.97, 0.98, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: dp(12)

                        MDIcon:
                            icon: "account-circle-outline"
                            theme_icon_color: "Custom"
                            icon_color: (0.24, 0.48, 0.95, 1)
                            size_hint: (None, None)
                            size: (dp(24), dp(24))
                            pos_hint: {"center_y": 0.5}

                        BoxLayout:
                            orientation: "vertical"
                            spacing: dp(2)
                            pos_hint: {"center_y": 0.5}

                            Label:
                                text: "Авторизованный пользователь"
                                bold: True
                                font_size: "15sp"
                                color: (0.1, 0.12, 0.16, 1)
                                halign: "left"
                                valign: "middle"
                                text_size: (self.width, None)

                            Label:
                                text: "ID: " + root.user_id
                                font_size: "13sp"
                                color: (0.45, 0.48, 0.54, 1)
                                halign: "left"
                                valign: "middle"
                                text_size: (self.width, None)

                # Logout button
                MDButton:
                    style: "tonal"
                    size_hint_y: None
                    height: dp(44)
                    pos_hint: {"center_x": 0.5}
                    on_release: root.on_logout_pressed()
                    MDButtonIcon:
                        icon: "logout"
                    MDButtonText:
                        text: "Выйти из аккаунта"

        # Bottom DockBar (Сообщения | >/. | Настройки)
        DockBar:
            id: dockbar
            active_tab: "settings"
