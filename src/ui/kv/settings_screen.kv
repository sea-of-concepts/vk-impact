#:kivy 2.3.0
#:import dp kivy.metrics.dp

<SettingsMenuItem>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(54)
    padding: [dp(20), dp(10)]
    spacing: dp(20)
    canvas.before:
        Color:
            rgba: app.divider_color if self.state == "down" else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

    on_release:
        app = app
        screen = self.parent
        while screen and not hasattr(screen, "open_section"): screen = screen.parent
        if screen: screen.open_section(root.target_screen)

    # Accent icon
    MDIcon:
        icon: root.icon_name
        theme_icon_color: "Custom"
        icon_color: app.accent_color
        size_hint: (None, None)
        size: (dp(26), dp(26))
        pos_hint: {"center_y": 0.5}

    # Category title
    Label:
        text: root.title_text
        font_size: "16sp"
        color: app.text_color
        halign: "left"
        valign: "middle"
        text_size: (self.width, None)
        pos_hint: {"center_y": 0.5}

    # Subtle chevron
    MDIcon:
        icon: "chevron-right"
        theme_icon_color: "Custom"
        icon_color: app.secondary_text_color
        size_hint: (None, None)
        size: (dp(20), dp(20))
        pos_hint: {"center_y": 0.5}


<SettingsScreen>:
    md_bg_color: app.bg_color

    FloatLayout:
        BoxLayout:
            orientation: "vertical"
            pos_hint: {"x": 0, "y": 0}
            size_hint: (1, 1)

            # Top App Bar
            MDTopAppBar:
                type: "small"
                theme_bg_color: "Custom"
                md_bg_color: app.surface_color

                MDTopAppBarTitle:
                    text: "Настройки"
                    theme_text_color: "Custom"
                    text_color: app.text_color

            # Categories list (SOVA style)
            ScrollView:
                do_scroll_x: False
                do_scroll_y: True

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [dp(8), dp(12), dp(8), dp(90)]
                    spacing: dp(4)

                    # 1. Аккаунт
                    SettingsMenuItem:
                        icon_name: "account-outline"
                        title_text: "Аккаунт"
                        target_screen: "account"

                    # 2. Персонализация / Внешний вид
                    SettingsMenuItem:
                        icon_name: "palette-outline"
                        title_text: "Персонализация"
                        target_screen: "personalization"

                    # 3. О приложении
                    SettingsMenuItem:
                        icon_name: "information-outline"
                        title_text: "О приложении"
                        target_screen: "about"

        # Bottom DockBar (Сообщения | >/. | Настройки)
        DockBar:
            id: dockbar
            active_tab: "settings"
            pos_hint: {"center_x": 0.5, "y": 0}
