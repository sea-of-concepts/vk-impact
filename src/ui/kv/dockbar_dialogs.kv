<DockbarSelectionDialog>:
    options_container: options_container
    size_hint: (0.88, None)
    height: dp(230) if root.dockbar_style == "pinterest" else dp(285)
    background_color: (0, 0, 0, 0.5)

    BoxLayout:
        orientation: "vertical"
        size_hint: (1, 1)
        padding: [dp(20), dp(18)]
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: app.card_bg
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(22)]

        Label:
            text: root.dialog_title
            font_size: "18sp"
            bold: True
            color: app.text_color
            size_hint_y: None
            height: dp(26)
            halign: "left"
            text_size: (self.width, None)

        BoxLayout:
            id: options_container
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(4)


