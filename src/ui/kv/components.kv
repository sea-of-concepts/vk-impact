#:kivy 2.3.0
#:import dp kivy.metrics.dp

<CircularAvatar>:
    # Background circle with deterministic user color (only when no image)
    canvas.before:
        Color:
            rgba: root.bg_color if not root.local_source else (0, 0, 0, 0)
        Ellipse:
            pos: 0, 0
            size: self.size

    # Initials Text (displayed instantly before/without image)
    Label:
        text: root.initials if not root.local_source else ""
        color: (1, 1, 1, 0.95)
        bold: True
        font_size: dp(root.size_dp * 0.36)
        halign: "center"
        valign: "middle"
        size_hint: (1, 1)
        pos: 0, 0
        opacity: 0 if root.local_source else 1

    # Avatar Image (smoothly fades in once downloaded)
    FitImage:
        source: root.local_source
        size_hint: (1, 1)
        pos: 0, 0
        radius: [dp(root.size_dp / 2)]
        opacity: 1 if root.local_source else 0

    # Online indicator badge
    Widget:
        size_hint: (None, None)
        size: (dp(12), dp(12))
        pos_hint: {"right": 1, "y": 0}
        opacity: 1 if root.is_online else 0
        canvas:
            Color:
                rgba: (0.22, 0.82, 0.38, 1)
            Ellipse:
                pos: self.pos
                size: self.size
            Color:
                rgba: (1, 1, 1, 1)
            Line:
                circle: (self.center_x, self.center_y, dp(6))
                width: 1.5


<FolderChip>:
    orientation: "horizontal"
    size_hint: (None, None)
    height: dp(32)
    width: max(dp(48), chip_lbl.texture_size[0] + dp(24))
    padding: [dp(12), dp(4)]
    canvas.before:
        Color:
            rgba: (0.24, 0.48, 0.95, 1) if root.is_active else (0.92, 0.93, 0.96, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]

    Label:
        id: chip_lbl
        text: root.title
        color: (1, 1, 1, 1) if root.is_active else (0.25, 0.28, 0.32, 1)
        bold: root.is_active
        font_size: "13sp"
        halign: "center"
        valign: "middle"


<MessageBubble>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(root.msg_size[1]) if root.msg_size else dp(64)
    padding: [dp(8), dp(2)]
    spacing: dp(8)

    # Left spacer for outgoing messages
    Widget:
        size_hint_x: 0.22 if root.is_outgoing else 0.001
        opacity: 0

    # Small sender avatar for incoming messages
    CircularAvatar:
        source: root.sender_avatar
        size_dp: 32
        size_hint_x: None
        width: dp(32) if (not root.is_outgoing and root.sender_avatar) else 0
        opacity: 1 if (not root.is_outgoing and root.sender_avatar) else 0
        pos_hint: {"bottom": 1}

    # Bubble container
    BoxLayout:
        id: content_box
        orientation: "vertical"
        size_hint_x: 0.78
        padding: [dp(16), dp(8)]
        spacing: dp(3)
        canvas.before:
            Color:
                rgba: (0.24, 0.48, 0.95, 1) if root.is_outgoing else (0.92, 0.93, 0.96, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(20), dp(20), dp(4) if root.is_outgoing else dp(20), dp(20) if root.is_outgoing else dp(4)]

        # Sender Name (for incoming messages)
        Label:
            text: root.sender_name
            color: (0.16, 0.44, 0.88, 1)
            bold: True
            font_size: "12sp"
            text_size: (self.width, None)
            size_hint_y: None
            height: dp(16) if (root.sender_name and not root.is_outgoing) else 0
            opacity: 1 if (root.sender_name and not root.is_outgoing) else 0
            halign: "left"
            valign: "middle"

        # Message Text
        Label:
            id: msg_label
            text: root.text
            color: (1, 1, 1, 1) if root.is_outgoing else (0.12, 0.12, 0.14, 1)
            text_size: (self.width, None)
            size_hint_y: 1
            halign: "left"
            valign: "middle"
            font_size: "15sp"

        # Timestamp and Read Status
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(14)
            spacing: dp(4)
            pos_hint: {"right": 1}

            Label:
                text: root.time_text
                color: (0.85, 0.92, 1, 0.85) if root.is_outgoing else (0.5, 0.52, 0.58, 1)
                font_size: "11sp"
                halign: "right"
                valign: "middle"
                text_size: (self.width, None)

            Label:
                text: "✓✓" if root.is_read else "✓"
                color: (0.85, 0.92, 1, 0.9)
                font_size: "11sp"
                size_hint_x: None
                width: dp(16) if root.is_outgoing else 0
                opacity: 1 if root.is_outgoing else 0
                halign: "right"
                valign: "middle"

    # Right spacer for incoming messages
    Widget:
        size_hint_x: 0.001 if root.is_outgoing else 0.22
        opacity: 0
