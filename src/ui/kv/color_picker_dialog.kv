#:kivy 2.3.0
#:import dp kivy.metrics.dp

<ColorPresetChip>:
    size_hint: (None, None)
    size: (dp(32), dp(32))
    canvas.before:
        Color:
            rgba: self.color_rgba
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: (0, 0, 0, 0.12)
        Line:
            circle: (self.center_x, self.center_y, dp(16))
            width: dp(1)


<ColorPickerDialog>:
    size_hint: (0.92, None)
    height: dp(540)
    background_color: (0, 0, 0, 0.5)

    BoxLayout:
        orientation: "vertical"
        size_hint: (1, 1)
        padding: [dp(22), dp(20)]
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: app.card_bg
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(24)]

        # Header Title
        Label:
            text: "Цвет акцента"
            font_size: "18sp"
            bold: True
            color: app.text_color
            size_hint_y: None
            height: dp(26)
            halign: "left"
            text_size: (self.width, None)

        # Color Preview Card
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(50)
            padding: [dp(16), dp(8)]
            spacing: dp(12)
            canvas.before:
                Color:
                    rgba: root.selected_rgba
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(14)]
                Color:
                    rgba: (0, 0, 0, 0.1)
                Line:
                    rounded_rectangle: [self.x, self.y, self.width, self.height, dp(14)]
                    width: dp(1)

            Label:
                text: root.selected_hex
                font_size: "16sp"
                bold: True
                color: (1, 1, 1, 1) if (root.r_val * 0.299 + root.g_val * 0.587 + root.b_val * 0.114) < 150 else (0.1, 0.1, 0.1, 1)
                halign: "center"
                valign: "middle"

        # Presets Section
        Label:
            text: "Быстрый выбор"
            font_size: "12sp"
            bold: True
            color: app.secondary_text_color
            size_hint_y: None
            height: dp(18)
            halign: "left"
            text_size: (self.width, None)

        GridLayout:
            cols: 8
            size_hint_y: None
            height: dp(72)
            spacing: dp(8)

            ColorPresetChip:
                color_hex: "#3D7BF5"
                on_release: root.select_preset("#3D7BF5")
            ColorPresetChip:
                color_hex: "#0077FF"
                on_release: root.select_preset("#0077FF")
            ColorPresetChip:
                color_hex: "#2979FF"
                on_release: root.select_preset("#2979FF")
            ColorPresetChip:
                color_hex: "#00BCD4"
                on_release: root.select_preset("#00BCD4")
            ColorPresetChip:
                color_hex: "#009688"
                on_release: root.select_preset("#009688")
            ColorPresetChip:
                color_hex: "#4CAF50"
                on_release: root.select_preset("#4CAF50")
            ColorPresetChip:
                color_hex: "#8BC34A"
                on_release: root.select_preset("#8BC34A")
            ColorPresetChip:
                color_hex: "#FFC107"
                on_release: root.select_preset("#FFC107")

            ColorPresetChip:
                color_hex: "#FF9800"
                on_release: root.select_preset("#FF9800")
            ColorPresetChip:
                color_hex: "#FF5722"
                on_release: root.select_preset("#FF5722")
            ColorPresetChip:
                color_hex: "#F44336"
                on_release: root.select_preset("#F44336")
            ColorPresetChip:
                color_hex: "#E91E63"
                on_release: root.select_preset("#E91E63")
            ColorPresetChip:
                color_hex: "#9C27B0"
                on_release: root.select_preset("#9C27B0")
            ColorPresetChip:
                color_hex: "#673AB7"
                on_release: root.select_preset("#673AB7")
            ColorPresetChip:
                color_hex: "#3F51B5"
                on_release: root.select_preset("#3F51B5")
            ColorPresetChip:
                color_hex: "#607D8B"
                on_release: root.select_preset("#607D8B")

        # RGB Sliders
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(140)
            spacing: dp(4)

            # Red Slider Row
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: dp(40)
                spacing: dp(8)

                Label:
                    text: "R"
                    bold: True
                    color: (0.9, 0.2, 0.2, 1)
                    size_hint: (None, 1)
                    width: dp(20)

                Slider:
                    min: 0
                    max: 255
                    step: 1
                    value: root.r_val
                    on_value:
                        root.r_val = self.value
                        root.on_slider_change()

                Label:
                    text: str(int(root.r_val))
                    color: (0.3, 0.33, 0.38, 1)
                    size_hint: (None, 1)
                    width: dp(34)
                    halign: "right"

            # Green Slider Row
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: dp(40)
                spacing: dp(8)

                Label:
                    text: "G"
                    bold: True
                    color: (0.15, 0.7, 0.3, 1)
                    size_hint: (None, 1)
                    width: dp(20)

                Slider:
                    min: 0
                    max: 255
                    step: 1
                    value: root.g_val
                    on_value:
                        root.g_val = self.value
                        root.on_slider_change()

                Label:
                    text: str(int(root.g_val))
                    color: (0.3, 0.33, 0.38, 1)
                    size_hint: (None, 1)
                    width: dp(34)
                    halign: "right"

            # Blue Slider Row
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: dp(40)
                spacing: dp(8)

                Label:
                    text: "B"
                    bold: True
                    color: (0.2, 0.45, 0.95, 1)
                    size_hint: (None, 1)
                    width: dp(20)

                Slider:
                    min: 0
                    max: 255
                    step: 1
                    value: root.b_val
                    on_value:
                        root.b_val = self.value
                        root.on_slider_change()

                Label:
                    text: str(int(root.b_val))
                    color: (0.3, 0.33, 0.38, 1)
                    size_hint: (None, 1)
                    width: dp(34)
                    halign: "right"

        # HEX Code Input
        MDTextField:
            mode: "outlined"
            size_hint_y: None
            height: dp(48)
            text: root.hex_input_text
            on_text: root.on_hex_text_input(self.text)
            MDTextFieldHintText:
                text: "HEX код (#RRGGBB)"

        # Error Message (if any)
        Label:
            text: root.error_message
            color: (0.9, 0.2, 0.2, 1)
            font_size: "11sp"
            size_hint_y: None
            height: dp(16) if root.error_message else 0
            opacity: 1 if root.error_message else 0

        # Action Buttons
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(48)
            spacing: dp(12)

            MDButton:
                style: "text"
                size_hint_x: 0.5
                on_release: root.dismiss()
                MDButtonText:
                    text: "Отмена"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}

            MDButton:
                style: "filled"
                size_hint_x: 0.5
                theme_bg_color: "Custom"
                md_bg_color: app.accent_color
                on_release: root.confirm_selection()
                MDButtonText:
                    text: "Выбрать"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
